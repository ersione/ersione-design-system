  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "jsx": "react-jsx", "strict": true, "declaration": true,
    "outDir": "lib/react", "rootDir": "src/react", "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/react/**/*.tsx"]
