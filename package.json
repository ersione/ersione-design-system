{
  "name": "@ersione/design-system",
  "version": "0.4.0",
  "private": false,
  "description": "Shared Ersione tokens, CSS primitives and React components",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "tokens",
    "docs",
    "README.md",
    "styles.css",
    "lib/react",
    "assets/favicon.svg",
    "assets/OFL-Noto-Sans-KR.txt"
  ],
  "exports": {
    "./tokens.css": "./tokens/tokens.css",
    "./tokens.json": "./tokens/tokens.json",
    "./styles.css": "./styles.css",
    "./react": {
      "types": "./lib/react/index.d.ts",
      "import": "./lib/react/index.js"
    },
    "./symbol.svg": "./assets/favicon.svg",
    "./charts": {
      "types": "./lib/react/chart-theme.d.ts",
      "import": "./lib/react/chart-theme.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs && npm run build:react",
    "check": "node scripts/check.mjs",
    "preview": "python -m http.server 8766 --bind 127.0.0.1 --directory dist",
    "build:react": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "npm run build:react && node --test tests/*.test.mjs",
    "build:playground": "node scripts/build-playground.mjs",
    "test:browser": "npm run build:playground && playwright test"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": ">=19.0.0 <20"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/react": "^19.2.0",
    "esbuild": "^0.28.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.11"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
